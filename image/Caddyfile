{
	admin off
	auto_https off
}

:{$PORT} {
	reverse_proxy 127.0.0.1:4777 {
		# The hub trusts forwarded headers only from loopback, and takes the LAST X-Forwarded-For
		# entry as the client (apps/hub clientAddress). Pass the edge's own headers through as-is:
		# Railway's edge appends the real client last, so a spoofed entry lands in front of it.
		header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}
}
